# aaPanel / producao
NODE_ENV=production
PORT=3000
HOSTNAME=127.0.0.1

# Use caminho absoluto no servidor para evitar ambiguidade do SQLite.
DATABASE_URL="file:/www/wwwroot/fireport_firenetwork_com_br/prisma/prod.db"

NEXTAUTH_URL="https://fireport.firenetwork.com.br"
NEXTAUTH_SECRET="gere-um-segredo-forte-com-openssl-rand-base64-32"
INITIAL_ADMIN_SETUP_TOKEN="gere-outro-token-forte-para-o-primeiro-admin"

HUBSOFT_API_URL="https://api.firenetwork.hubsoft.com.br"
HUBSOFT_OAUTH_PATH="/oauth/token"
HUBSOFT_CLIENT_ID=""
HUBSOFT_CLIENT_SECRET=""
HUBSOFT_USERNAME=""
HUBSOFT_PASSWORD=""
HUBSOFT_PROJECT_ID=4
emenda=nao
atendimento=sim

GOOGLE_GEOCODING_API_KEY=""
NEXT_PUBLIC_CTO_RADIUS_METERS=150

OLT_DRIVER=zte-c650
OLT_DEFAULT_GEM_PORT=1
OLT_DEFAULT_TCONT=1
OLT_DEFAULT_SERVICE_VLAN=600
OLT_DEFAULT_SERVICE_NAME=internet

# Em producao, ligue depois de validar credenciais, banco e acesso as OLTs.
ONU_MONITOR_AUTO_START=false
OLT_MONITOR_AUTO_START=false
